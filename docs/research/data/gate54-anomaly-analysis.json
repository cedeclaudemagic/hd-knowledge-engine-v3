      "line": 1,
      "keynote": "Influence",
      "polarity": "YANG",
      "exaltation": [
        {
          "planet": "Pluto",
          "description": {
            "blackBook": "The ability to achieve influence through secret relationships, anywhere from the private adviser to the satanist",
            "whiteBook": "Ambition energized through secret relationships which fuel influence."
          }
        }
      ],
      "detriment": [
        {
          "planet": "Venus",
          "description": {
            "blackBook": "A socially misguided insistence on formal recognition of a relationship, that in terms of influence, will diminish its power",
            "whiteBook": "Ambition which demands formal recognition limiting influence."
          }
        }
      ]
    },
    {
      "line": 2,
      "keynote": "Discretion",
      "polarity": "YANG",
      "exaltation": [
        {
          "planet": "Saturn",
          "description": {
            "blackBook": "The wisdom once a relationship is formally recognized to restrain the temptation to take advantage of past informal interactions",
            "whiteBook": "The energy of restraint fuels ambition."
          }
        }
      ],
      "detriment": [
        {
          "planet": "Mars",
          "description": {
            "blackBook": "Recognition, in the formal sense, seen as a licence to take advantage of informal knowledge. A lack of loyalty",
            "whiteBook": null
          }
        }
      ]
    },
    {
      "line": 3,
      "keynote": "Covert interaction",
      "polarity": "YIN",
      "exaltation": [
        {
          "planet": "Pluto",
          "description": {
            "blackBook": "The ability when stymied in formal relationships to use secret or purely psychic channels, when it is the only resort",
            "whiteBook": "The drive when blocked to use secret means to fuel ambition."
          }
        }
      ],
      "detriment": [
        {
          "planet": "Venus",
          "description": {
            "blackBook": "The insistence that formal channels, no matter how frustrating, can be overcome by the power of attraction",
            "whiteBook": "The energy of ambition when blocked will fuel the power of attraction to overcome the obstacle."
          }
        }
      ]
    },
