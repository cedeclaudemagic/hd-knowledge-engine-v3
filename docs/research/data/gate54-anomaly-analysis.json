      "polarity": "YIN",
      "exaltation": [
        {
          "planet": "Saturn",
          "description": {
            "blackBook": "The ingrained responsibility, in terms of maintaining security and personal identity that will naturally restrict its relationships to ones that are mutually beneficial",
            "whiteBook": "The energy to restrict relationships that hinder ambition."
          }
        }
      ],
      "detriment": [
        {
          "planet": "Jupiter",
          "description": {
            "blackBook": "A generally benefic and expansive nature that assumes that it can instill, what is otherwise missing in its partners. A waste of energy",
            "whiteBook": "The waste of energy in maintaining relationships which hinder ambition."
          }
        }
      ]
    }
